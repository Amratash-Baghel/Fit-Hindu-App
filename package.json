{
  "name": "fit-hindu",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint"
  },
  "expo": {
    "autolinking": {
      "//": "Both ship inside the `expo` package and autolink by default; nothing in this app imports either. @expo/ui alone drags Jetpack Compose into the APK (~1.9MB AAR + Compose runtime) and @expo/dom-webview pulls androidx.webview — dead weight for a 50-70MB budget. Remove an entry here the moment a screen actually uses one ('use dom' components need dom-webview).",
      "exclude": ["@expo/ui", "@expo/dom-webview"]
    }
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.110.2",
    "expo": "~57.0.12",
    "expo-audio": "~57.0.3",
    "expo-constants": "~57.0.3",
    "expo-dev-client": "~57.0.11",
    "expo-haptics": "~57.0.1",
    "expo-keep-awake": "~57.0.0",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.5",
    "expo-notifications": "~57.0.10",
    "expo-router": "~57.0.12",
    "expo-splash-screen": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "expo-video": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-reanimated": "~4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.1",
    "typescript": "~6.0.3"
  },
  "private": true
}
